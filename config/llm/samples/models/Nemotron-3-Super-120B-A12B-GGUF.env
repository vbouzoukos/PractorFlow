LLM_MODEL=unsloth/NVIDIA-Nemotron-3-Super-120B-A12B-GGUF/NVIDIA-Nemotron-3-Super-120B-A12B-UD-IQ4_XS.gguf
LLM_BACKEND=llama_cpp
LLM_DEVICE=auto
LLM_DTYPE=auto
LLM_QUANTIZATION=4bit
LLM_MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_MODELS_DIR=models
LLM_GPU_LAYERS=-1
LLM_N_CTX=32768
LLM_N_BATCH=2048
# LLM_STOP_TOKENS=</s>,<|endoftext|>
LLM_MAX_SEARCH_RESULTS=5
# Transformers specific optimizations
LLM_USE_TORCH_COMPILE=true
LLM_COMPILE_MODE=reduce-overhead
LLM_WARMUP_ON_LOAD=true