# API Authentication Configuration

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_TOKEN_EXPIRY_MINUTES=43200
# Local mode admin (set ADMIN_SECRET in secrets/config.env to enable admin mode)

# OIDC Configuration
# When OIDC_ISSUER_URL is empty: Local authentication mode
# When OIDC_ISSUER_URL is set: OIDC authentication mode
# OIDC_ISSUER_URL=
# OIDC_AUDIENCE=

# JOBS
CLEANUP_INTERVAL_MINUTES=360

# Logging
API_LOG_LEVEL=INFO

API_TOOLS_DB_PATH=data/tools/tools.json
MCP_SERVERS_DB_PATH=data/tools/mcp.json
USER_TOOL_DB_PATH=data/tools/user_tools.json